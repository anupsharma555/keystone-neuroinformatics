<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <p class="footer-brand">{{ site.name }}</p>
      <p class="footer-copy">Computational neuroscience and behavioral health informatics.</p>
    </div>
    <div>
      <p><a href="mailto:{{ site.contact.info }}">{{ site.contact.info }}</a></p>
      <p><a href="mailto:{{ site.contact.collaborate }}">{{ site.contact.collaborate }}</a></p>
    </div>
  </div>
  <div class="container footer-meta">
    <p>&copy; {{ site.copyrightYear }} {{ site.name }}. All rights reserved.</p>
    <p><a href="/credits/">Image credits</a></p>
  </div>
</footer>
