{
  "name": "keystone-neuroinformatics-site",
  "version": "1.0.0",
  "private": true,
  "description": "Eleventy-powered static site scaffold for Keystone Neuroinformatics",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "eleventy",
    "dev": "eleventy --serve",
    "clean": "rm -rf _site",
    "audit:metadata": "node scripts/audit-metadata.mjs",
    "audit:metadata:strict": "node scripts/audit-metadata.mjs --strict",
    "verify:live": "scripts/verify-live-site.sh",
    "deploy:cloudflare": "scripts/deploy-cloudflare-pages.sh",
    "cloudflare:traffic": "scripts/cloudflare_traffic_summary.sh",
    "indexnow:submit": "node scripts/submit-indexnow.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.0"
  }
}
